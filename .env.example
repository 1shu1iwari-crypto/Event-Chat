# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
COMETCHAT_APP_ID=
COMETCHAT_REGION=in
COMETCHAT_REST_API_KEY=
# Shared hackathon access code; required on non-localhost deployments.
# This is a demo staff selector, not individual production identity verification.
EVENTOPS_ACCESS_CODE=
# Generate using: openssl rand -hex 32
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
# Postgres/Supabase pooled connection string for durable deployments.
# Without this, single-process local development writes to .data/event.json.
DATABASE_URL=
EVENTOPS_DATA_DIR=.data
# Optional OpenAI-compatible service; LIVE mode falls back to deterministic rules.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
